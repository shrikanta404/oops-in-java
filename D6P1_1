// Three base interfaces
interface A {
    void methodA1();
    void methodA2();
}

interface B {
    void methodB1();
    void methodB2();
}

interface C {
    void methodC1();
    void methodC2();
}

// New interface inheriting all three + one new method
interface D extends A, B, C {
    void methodD();
}

// Concrete base class
class Base {
    void show() {
        System.out.println("Base class method");
    }
}

// Class implementing D and extending Base
class MyClass extends Base implements D {
    public void methodA1() { System.out.println("A1"); }
    public void methodA2() { System.out.println("A2"); }
    public void methodB1() { System.out.println("B1"); }
    public void methodB2() { System.out.println("B2"); }
    public void methodC1() { System.out.println("C1"); }
    public void methodC2() { System.out.println("C2"); }
    public void methodD()  { System.out.println("D - new method"); }
}

// Four methods each taking one interface as argument
class Test {
    static void takeA(A obj) { obj.methodA1(); obj.methodA2(); }
    static void takeB(B obj) { obj.methodB1(); obj.methodB2(); }
    static void takeC(C obj) { obj.methodC1(); obj.methodC2(); }
    static void takeD(D obj) { obj.methodD(); }

    public static void main(String[] args) {
        MyClass obj = new MyClass();
        takeA(obj);
        takeB(obj);
        takeC(obj);
        takeD(obj);
        obj.show();  // Base class method
    }
}
